#include <stdio.h>

int binarySearch(int arr[], int size, int target) {
    int low = 0, high = size - 1;
    while (low <= high) {
        int mid = (low + high) / 2;
        if (arr[mid] == target)
            return mid;
        else if (arr[mid] < target)
            low = mid + 1;
        else
            high = mid - 1;
    }
    return -1;
}

int main() {
    int arr[] = {10, 50, 100, 200, 300, 400, 500, 600, 700};
    int size = 9;
    int result = binarySearch(arr, size, 500);

    if (result!= -1)
        printf("500 found at position %d\n", result);
    else
        printf("500 not found\n");

    return 0;
}
